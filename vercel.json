{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/Erick_Pradhan.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=Erick_Pradhan.pdf" }]
    },
    {
      "source": "/(favicon.svg|Porfolio.jpg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    }
  ]
}